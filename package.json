{
  "name": "pflichtwaechter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pflichtwaechter/web dev",
    "build": "pnpm db:generate && pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint .",
    "typecheck": "pnpm db:generate && pnpm -r --if-present run typecheck",
    "worker": "pnpm --filter @pflichtwaechter/worker start",
    "rules:eval": "pnpm --filter @pflichtwaechter/rules run eval",
    "db:generate": "pnpm --filter @pflichtwaechter/db run generate",
    "db:deploy": "pnpm --filter @pflichtwaechter/db run deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
