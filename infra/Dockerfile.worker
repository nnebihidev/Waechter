# Worker image: runs migrations, then the job loop.
# Playwright joins in Phase 2 (switch base to mcr.microsoft.com/playwright or
# install chromium deps here).
FROM node:22-alpine
# openssl: required by Prisma's query engine on Alpine.
RUN apk add --no-cache openssl && corepack enable
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/worker/package.json apps/worker/
COPY packages/db/package.json packages/db/
COPY packages/rules/package.json packages/rules/
RUN pnpm install --frozen-lockfile --filter @pflichtwaechter/worker...

COPY packages ./packages
COPY apps/worker ./apps/worker
RUN pnpm --filter @pflichtwaechter/db run generate

CMD ["sh", "-c", "pnpm --filter @pflichtwaechter/db run deploy && pnpm --filter @pflichtwaechter/worker run start"]
