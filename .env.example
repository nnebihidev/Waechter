# --- App ---
APP_URL=https://pflichtwaechter.example
FOUNDER_EMAIL=founder@example.com
ADMIN_EMAILS=founder@example.com

# --- Database ---
DATABASE_URL=postgresql://pflichtwaechter:pflichtwaechter@localhost:5432/pflichtwaechter

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_REPORT=
STRIPE_PRICE_WATCHER=
STRIPE_PRICE_AGENCY=

# --- Email ---
EMAIL_FROM="Pflichtwächter <post@pflichtwaechter.example>"
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Pricing / tax display: inkl | zzgl | kleinunternehmer ---
VAT_MODE=kleinunternehmer

# --- LLM (optional; rule engine and reports work with none) ---
LLM_PROVIDER=none
LLM_API_KEY=

# --- Crawler ---
CRAWL_CONCURRENCY=2
RETENTION_HTML_DAYS=30

# --- docker-compose only ---
POSTGRES_PASSWORD=pflichtwaechter
DOMAIN=pflichtwaechter.example
