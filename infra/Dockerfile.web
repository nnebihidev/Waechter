# Next.js standalone build for the pnpm monorepo.
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/db/package.json packages/db/
COPY packages/rules/package.json packages/rules/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm --filter @pflichtwaechter/db run generate \
  && pnpm --filter @pflichtwaechter/web run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
# openssl: required by Prisma's query engine on Alpine.
RUN apk add --no-cache openssl && addgroup -S app && adduser -S app -G app
COPY --from=build --chown=app:app /app/apps/web/.next/standalone ./
COPY --from=build --chown=app:app /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=app:app /app/apps/web/public ./apps/web/public
COPY --from=build --chown=app:app /app/legal ./legal
USER app
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
